# MongoDB (use Atlas for production: https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/theledger?retryWrites=true&w=majority

# Auth (generate a random secret: openssl rand -base64 32)
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing
LEAD_COST_DEFAULT=2
LEAD_COST_CENTS=200

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: White-label overrides
# NEXT_PUBLIC_CURRENCY=INR
# NEXT_PUBLIC_CURRENCY_SYMBOL=₹
# NEXT_PUBLIC_DOMAIN=yourdomain.com
# SUPPORT_EMAIL=support@yourdomain.com
